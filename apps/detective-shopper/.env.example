IMPACT_API_KEY=
SPOONACULAR_API_KEY=
# Data integrations (see /admin)
UPC_DATABASE_KEY=
COUPON_FEED_API_KEY=
# Optional: tag affiliate clicks by media partner
IMPACT_MEDIA_PARTNER_ID=
# Sign in with Google (public OAuth client id) + session signing secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
