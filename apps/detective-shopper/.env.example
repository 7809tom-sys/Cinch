# Durable storage (Redis via Vercel Marketplace / Upstash).
# Used by admin analytics, accounts, and the shopping list
# (keys prefixed detective-shopper:shopping-list:).
# Auto-injected when you add a Redis store in Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional: protect /admin (leave empty to allow open access in development)
ADMIN_PASSWORD=
