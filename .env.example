OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
# test = pre-launch checklist mode (default); live = public launch
CINCH_LAUNCH_MODE=test
# Owner/admin emails billed at $0 for dogfooding / QA (comma-separated)
# Platform owner 7809tom@gmail.com is always included.
CINCH_FREE_ADMIN_EMAILS=7809tom@gmail.com
# Master admin Google allowlist (owner is always included; add more if needed)
CINCH_MASTER_EMAILS=7809tom@gmail.com
# Master admin password (email must be on CINCH_MASTER_EMAILS / owner).
# In test mode, defaults to: cinch-seed
CINCH_MASTER_PASSWORD=
# Optional Google Web OAuth — OFF by default.
# A client ID that only looks valid still causes Google Error 401: invalid_client
# when the OAuth client is wrong/deleted. Do NOT set LOGIN_ENABLED until the
# Web client works in Google Cloud (Authorized JS origins include your domain).
# 1) Create OAuth client ID type "Web application" ending in .apps.googleusercontent.com
# 2) Set NEXT_PUBLIC_GOOGLE_CLIENT_ID
# 3) Set NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=true and redeploy
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=false
AUTH_SECRET=
# Optional: UPC / barcode catalog for Seed e-commerce admin (UPCitemdb).
# When set, scan-to-add uses the paid endpoint; otherwise free trial lookup.
UPC_DATABASE_KEY=
# Cloudflare Registrar (domain search + booking)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Optional override for GA (also configurable in Admin)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional: serve LockGM at the root of its own domain (e.g. lockgm.com/office
# instead of cinchseed.com/lockgm/office). Connect + verify DNS in
# Admin → Domains first, add the domain in Vercel Project Settings → Domains,
# then set this and redeploy.
LOCKGM_DOMAIN=
