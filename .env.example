OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
# test = pre-launch checklist mode (default); live = public launch
CINCH_LAUNCH_MODE=test
# Owner/admin emails billed at $0 for dogfooding / QA (comma-separated)
# Platform owner 7809tom@gmail.com is always included.
CINCH_FREE_ADMIN_EMAILS=7809tom@gmail.com
# Master admin Google allowlist (owner is always included; add more if needed)
CINCH_MASTER_EMAILS=7809tom@gmail.com
# One Google Web OAuth client powers public sign-in/sign-up AND master admin.
# Create once: Google Cloud → Credentials → OAuth client ID → Web application.
# Origins: https://www.cinchseed.com, https://cinchseed.com, http://localhost:3000
# Anyone can then sign in/up with Google. Master admin stays allowlisted separately.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
AUTH_SECRET=
# Cloudflare Registrar (domain search + booking)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Optional override for GA (also configurable in Admin)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
