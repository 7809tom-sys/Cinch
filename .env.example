OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
# test = pre-launch checklist mode (default); live = public launch
CINCH_LAUNCH_MODE=test
# Owner/admin emails billed at $0 for dogfooding / QA (comma-separated)
CINCH_FREE_ADMIN_EMAILS=
# Master admin Google allowlist (falls back to CINCH_FREE_ADMIN_EMAILS)
CINCH_MASTER_EMAILS=
# Sign in with Google (public OAuth client id) + session signing secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
AUTH_SECRET=
# Cloudflare Registrar (domain search + booking)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Optional override for GA (also configurable in Admin)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
