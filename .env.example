OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
# test = pre-launch checklist mode (default); live = public launch
CINCH_LAUNCH_MODE=test
# Owner/admin emails billed at $0 for dogfooding / QA (comma-separated)
# Platform owner 7809tom@gmail.com is always included.
CINCH_FREE_ADMIN_EMAILS=7809tom@gmail.com
# Master admin Google allowlist (owner is always included; add more if needed)
CINCH_MASTER_EMAILS=7809tom@gmail.com
# Sign in with Google (Master + customer login)
# Create OAuth client ID type "Web application" in Google Cloud Console →
# APIs & Services → Credentials (NOT Google AI Studio / GOOGLE_AI_API_KEY).
# Authorized JavaScript origins: https://www.cinchseed.com, https://cinchseed.com,
# http://localhost:3000
# Value looks like: 123456789-xxxx.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Long random string for signing session cookies (required in production)
AUTH_SECRET=
# Cloudflare Registrar (domain search + booking)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Optional override for GA (also configurable in Admin)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
