OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
# test = pre-launch checklist mode (default); live = public launch
CINCH_LAUNCH_MODE=test
# Owner/admin emails billed at $0 for dogfooding / QA (comma-separated)
# Platform owner 7809tom@gmail.com is always included.
CINCH_FREE_ADMIN_EMAILS=7809tom@gmail.com
# Master admin Google allowlist (owner is always included; add more if needed)
CINCH_MASTER_EMAILS=7809tom@gmail.com
# Master admin password (email must be on CINCH_MASTER_EMAILS / owner).
# In test mode, defaults to: cinch-seed
CINCH_MASTER_PASSWORD=
# Optional Google Web OAuth (must end in .apps.googleusercontent.com).
# Broken / placeholder values are ignored so login does not show invalid_client.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
AUTH_SECRET=
# Cloudflare Registrar (domain search + booking)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Optional override for GA (also configurable in Admin)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
