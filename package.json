{
  "name": "cinch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "assert:seed-industry": "npx tsx scripts/assert-seed-industry.ts",
